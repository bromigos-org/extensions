{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bromigos-org/extensions/blob/main/schema/bromigos-ext.schema.json",
  "title": "bromigos-ext.toml",
  "description": "A bromigOS extension's manifest (docs/extensions.md in bromigOS). bromigos ext checks more than this (files exist, symlinks stay inside, permissions match the parts); this is the shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extension",
    "requires",
    "provides"
  ],
  "properties": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "description": "the id: lowercase letters, digits, - and _"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licence": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "homepage": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bromigos"
      ],
      "properties": {
        "bromigos": {
          "type": "string",
          "minLength": 1,
          "description": "the extension API range, e.g. \">=1.0, <2\""
        }
      }
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "enum": [
              "theme",
              "live-deck",
              "live-layer",
              "widget",
              "vector-tool",
              "vector-memory",
              "vector-skill",
              "homelab-adapter",
              "command",
              "hook"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/|^-|(^|/)\\.\\.(/|$))"
            },
            "description": "relative to the extension's folder; never absolute, never .."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "enum": [
              "theme-set"
            ],
            "description": "a hook's event"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "oneOf": [
            {
              "enum": [
                "none",
                "any"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$"
              }
            }
          ]
        },
        "filesystem": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vector": {
          "enum": [
            "read",
            "desktop"
          ],
          "description": "VECTOR tool level; never the terminal"
        },
        "code": {
          "type": "boolean"
        }
      }
    }
  }
}
